              "<body>\n",
              "<h1>Fuerzas de Starling a través de la membrana peritoneal</h1>\n",
              "<div class=\"eq\">\n",
              "<b>Ecuación (flujo hacia la cavidad):</b> dV/dt = J<sub>v</sub> = L<sub>p</sub>·S·[ (P<sub>v</sub> − P<sub>I</sub>) + σ<sub>g</sub>·π<sub>I</sub> − σ<sub>p</sub>·π<sub>v</sub> ] = L<sub>p</sub>·S·[ −ΔP + σΔπ ]<br>\n",
              "<span style=\"color:var(--mut);font-size:.82rem\">El esquema escribe (P<sub>I</sub> − P<sub>v</sub>) − σ(π<sub>I</sub> − π<sub>v</sub>), que es el mismo flujo con el signo contrario: ahí un valor positivo significa paso de la cavidad hacia la sangre.</span>\n",
              "</div>\n",
              "<canvas id=\"c\" width=\"900\" height=\"430\"></canvas>\n",
              "<div id=\"res\"></div>\n",
              "<div class=\"row\">\n",
              "  <label>P<sub>v</sub> capilar: <b id=\"v1\"></b> mmHg<input id=\"pv\" type=\"range\" min=\"10\" max=\"40\" step=\"0.5\" value=\"20\"></label>\n",
              "  <label>P<sub>I</sub> intraperitoneal: <b id=\"v2\"></b> mmHg<input id=\"pi\" type=\"range\" min=\"0\" max=\"25\" step=\"0.5\" value=\"8\"></label>\n",
              "  <label>π<sub>v</sub> oncótica plasmática: <b id=\"v3\"></b> mmHg<input id=\"po\" type=\"range\" min=\"10\" max=\"35\" step=\"0.5\" value=\"25\"></label>\n",
              "  <label>Glucosa inicial del dializado: <b id=\"v4\"></b> mmol/L<input id=\"cg\" type=\"range\" min=\"0\" max=\"250\" step=\"1\" value=\"126\"></label>\n",
              "  <label>σ glucosa: <b id=\"v5\"></b><input id=\"sg\" type=\"range\" min=\"0\" max=\"0.2\" step=\"0.005\" value=\"0.04\"></label>\n",
              "  <label>σ proteínas: <b id=\"v6\"></b><input id=\"sp\" type=\"range\" min=\"0\" max=\"1\" step=\"0.01\" value=\"0.83\"></label>\n",
              "  <label>L<sub>p</sub>: <b id=\"v7\"></b> ×10⁻⁶ mL/min/mmHg/cm²<input id=\"Lp\" type=\"range\" min=\"1\" max=\"15\" step=\"0.1\" value=\"7.4\"></label>\n",
              "  <label>S: <b id=\"v8\"></b> cm²<input id=\"S\" type=\"range\" min=\"5000\" max=\"20000\" step=\"500\" value=\"10000\"></label>\n",
              "  <label>Tiempo de permanencia: <b id=\"v9\"></b> min<input id=\"tm\" type=\"range\" min=\"0\" max=\"360\" step=\"1\" value=\"0\"></label>\n",
              "  <label style=\"flex-direction:row;align-items:center;gap:6px\"><input id=\"one\" type=\"checkbox\"> Un solo σ (como en el esquema)</label>\n",
              "  <button id=\"pl\">Reproducir</button>\n",
              "</div>\n",
              "<canvas id=\"g\" width=\"900\" height=\"230\"></canvas>\n",
              "<script>\n",
              "const $=id=>document.getElementById(id),ctx=$('c').getContext('2d'),gx=$('g').getContext('2d');\n",
              "const RT=19.3,Cp=5.5,Jl=.3,TAU=150,MX=450,MW=14;\n",
              "const rnd=(a,b)=>a+Math.random()*(b-a);\n",
              "const Pm=()=>{const sg=+$('sg').value;return{pv:+$('pv').value,pI:+$('pi').value,po:+$('po').value,cg:+$('cg').value,sg,sp:$('one').checked?sg:+$('sp').value,Lp:+$('Lp').value*1e-6,S:+$('S').value,tm:+$('tm').value}};\n",
              "function calc(p,t){\n",
              " const e=Math.exp(-t/TAU),c=Cp+(p.cg-Cp)*e,piI=RT*(p.cg-Cp)*e;\n",
              " const Fh=p.pv-p.pI,Fs=p.sg*piI,Fo=p.sp*p.po,net=Fh+Fs-Fo,J=p.Lp*p.S*net;\n",
              " return{c,piI,Fh,Fs,Fo,net,J,UF:J-Jl}}\n",
              "function arrow(x,y,len,col){\n",
              " ctx.strokeStyle=col;ctx.fillStyle=col;ctx.lineWidth=8;ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x+len,y);ctx.stroke();\n",
              " const d=len>=0?1:-1;ctx.beginPath();ctx.moveTo(x+len+d*16,y);ctx.lineTo(x+len,y-11);ctx.lineTo(x+len,y+11);ctx.fill()}\n",
              "const water=Array.from({length:45},()=>({x:rnd(0,900),y:rnd(36,110)}));\n",
              "const glu=Array.from({length:90},()=>({x:rnd(MX+MW+20,880),y:rnd(130,410)}));\n",
              "const cells=[[60,190],[130,300],[90,380],[250,140],[300,350],[200,250]];\n",
              "const prot=Array.from({length:14},()=>({x:rnd(20,MX-MW-20),y:rnd(130,410)}));\n",
              "function draw(){\n",
              " const p=Pm(),r=calc(p,p.tm),cs=getComputedStyle(document.documentElement),fg=cs.getPropertyValue('--fg');\n",
              " ctx.clearRect(0,0,900,430);\n",
              " ctx.fillStyle=cs.getPropertyValue('--bl');ctx.fillRect(0,0,MX-MW,430);\n",
              " ctx.fillStyle=cs.getPropertyValue('--pe');ctx.fillRect(MX+MW,0,450-MW,430);\n",
              " ctx.fillStyle=cs.getPropertyValue('--mem');ctx.fillRect(MX-MW,0,MW*2,430);\n",
              " ctx.fillStyle=fg;ctx.font='bold 13px system-ui';ctx.textAlign='center';\n",
              " ctx.fillText('PLASMA (capilar sanguíneo)',MX/2,18);ctx.fillText('MEMBRANA',MX,18);ctx.fillText('CAVIDAD PERITONEAL (dializado)',MX+MX/2,18);\n",
              " ctx.fillStyle='rgba(200,40,40,.55)';cells.forEach(([x,y])=>{ctx.beginPath();ctx.ellipse(x,y,22,13,0,0,6.283);ctx.fill()});\n",
              " ctx.fillStyle='#8e44ad';prot.forEach(d=>{ctx.beginPath();ctx.arc(d.x,d.y,5,0,6.283);ctx.fill()});\n",
              " const n=Math.round(90*Math.min(1,r.c/250));ctx.fillStyle='#2e9e5b';\n",
              " for(let i=0;i<n;i++){ctx.beginPath();ctx.arc(glu[i].x,glu[i].y,4,0,6.283);ctx.fill()}\n",
              " const sp=Math.max(-4,Math.min(4,r.J*.5));ctx.fillStyle='#4aa3ff';\n",
              " for(const d of water){d.x+=sp;if(d.x>900)d.x-=900;if(d.x<0)d.x+=900;ctx.beginPath();ctx.arc(d.x,d.y,3,0,6.283);ctx.fill()}\n",
              " const k=1.5,cap=190,cl=v=>Math.min(cap,v*k);\n",
              " ctx.font='12px system-ui';\n",
              " ctx.fillStyle=fg;ctx.textAlign='right';ctx.fillText('Pv (hidrostática capilar) = '+p.pv.toFixed(1)+' mmHg',MX-MW-8,160);\n",
              " arrow(MX-MW-cl(Math.max(p.pv,0))-4,178,cl(Math.max(p.pv,0)),'#e53935');\n",
              " ctx.textAlign='left';ctx.fillStyle=fg;ctx.fillText('PI (hidrostática intraperitoneal) = '+p.pI.toFixed(1)+' mmHg',MX+MW+8,160);\n",
              " arrow(MX+MW+cl(p.pI)+4,178,-cl(p.pI),'#2e9e5b');\n",
              " ctx.textAlign='right';ctx.fillStyle=fg;ctx.fillText('σp·πv (oncótica efectiva) = '+r.Fo.toFixed(1)+' mmHg',MX-MW-8,262);\n",
              " arrow(MX-MW-4,282,-cl(r.Fo),'#8e44ad');\n",
              " ctx.textAlign='left';ctx.fillStyle=fg;ctx.fillText('σg·πI (osmótica efectiva) = '+r.Fs.toFixed(1)+' mmHg',MX+MW+8,262);\n",
              " arrow(MX+MW+4,282,cl(r.Fs),'#2f6fe0');\n",
              " ctx.textAlign='center';ctx.fillStyle=fg;ctx.font='bold 13px system-ui';\n",
              " ctx.fillText('Fuerza neta = '+r.net.toFixed(1)+' mmHg '+(r.net>=0?'(hacia la cavidad)':'(hacia la sangre)'),MX,350);\n",
              " arrow(MX,376,Math.max(-cap*1.2,Math.min(cap*1.2,r.net*k)),'#d97706');\n",
              " ctx.fillStyle=fg;ctx.font='11px system-ui';ctx.textAlign='left';ctx.fillText('← hacia la sangre',10,424);ctx.textAlign='right';ctx.fillText('hacia la cavidad (ultrafiltración) →',890,424);\n",
              " [r.Fh&&0,0].length;\n",
              " ['pv','pi','po','cg','sg','sp','Lp','S','tm'].forEach((id,i)=>$('v'+(i+1)).textContent=id==='sp'?p.sp.toFixed(2):(+$(id).value));\n",
              " $('sp').disabled=$('one').checked;\n",
              " $('res').innerHTML=`Glucosa del dializado: <b>${r.c.toFixed(0)} mmol/L</b> (π<sub>I</sub> = ${r.piI.toFixed(0)} mmHg) · ΔP = P<sub>I</sub> − P<sub>v</sub> = <b>${(p.pI-p.pv).toFixed(1)} mmHg</b> · L<sub>p</sub>S = <b>${(p.Lp*p.S).toFixed(3)} mL/min/mmHg</b><br>J<sub>v</sub> = <b>${r.J.toFixed(2)} mL/min</b> · con linfática (${Jl} mL/min): <b>${r.UF.toFixed(2)} mL/min</b> · UF acumulada: <b>${cum(p,p.tm).toFixed(0)} mL</b>`;\n",
              " plot(p)}\n",
              "function cum(p,t){let s=0;for(let m=0;m<t;m++)s+=calc(p,m).UF;return s}\n",
              "function plot(p){\n",
              " const fg=getComputedStyle(document.documentElement).getPropertyValue('--fg');\n",
              " gx.clearRect(0,0,900,230);const L=55,R=880,T=18,B=190;\n",
              " const ys=[];for(let m=0;m<=360;m+=4)ys.push(calc(p,m).UF);\n",
              " const hi=Math.max(1,...ys),lo=Math.min(0,...ys),Y=y=>B-(y-lo)/(hi-lo)*(B-T),X=m=>L+m/360*(R-L);\n",
              " gx.strokeStyle='rgba(120,120,120,.4)';gx.lineWidth=1;gx.beginPath();gx.moveTo(L,Y(0));gx.lineTo(R,Y(0));gx.stroke();\n",
              " gx.fillStyle=fg;gx.font='11px system-ui';gx.textAlign='right';gx.fillText(hi.toFixed(1),L-6,T+4);gx.fillText('0',L-6,Y(0)+4);\n",
              " gx.textAlign='center';[0,60,120,180,240,300,360].forEach(m=>gx.fillText(m,X(m),B+16));\n",
              " gx.fillText('Tiempo (min)',(L+R)/2,B+32);gx.save();gx.translate(14,(T+B)/2);gx.rotate(-Math.PI/2);gx.fillText('Ultrafiltración neta (mL/min)',0,0);gx.restore();\n",
              " gx.strokeStyle='#d97706';gx.lineWidth=2.5;gx.beginPath();ys.forEach((y,i)=>{i?gx.lineTo(X(i*4),Y(y)):gx.moveTo(X(0),Y(y))});gx.stroke();\n",
              " gx.fillStyle='#d97706';gx.beginPath();gx.arc(X(p.tm),Y(calc(p,p.tm).UF),5,0,6.283);gx.fill()}\n",
