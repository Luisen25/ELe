        "const flowing=!complete;const fi=flowing&&r.phase===0,fo=flowing&&r.phase===2;canvasArrow(c,215,325,122,fi?'#2996df':'#8993a155');canvasArrow(c,575,680,122,fo?'#df8b27':'#8993a155');c.font='12px system-ui';c.fillStyle=fg;c.fillText(fi?a.fillrate+' mL/min':'0 mL/min',270,100);c.fillText(fo?a.drainrate+' mL/min':'0 mL/min',625,100);if(fi||fo){const x=fi?215:575,w=fi?110:105;for(let i=0;i<5;i++){c.fillStyle=fi?'#2996df':'#df8b27';c.beginPath();c.arc(x+((seconds*35+i*23)%w),122,4,0,Math.PI*2);c.fill()}}\n",
        "g.fillStyle=fg;g.font='bold 15px system-ui';g.textAlign='center';g.fillText('PLASMA',230,24);g.fillText('MEMBRANA',450,24);g.fillText('CAVIDAD / DIALIZADO',690,24);\n",
        "species.forEach((sp,i)=>{const y=40+i*120,flux=r[sp.key],dir=Math.sign(flux),cp=[null,Cp,a.ureap,a.albp][i],cd=[null,r.gd,r.ud,r.ad][i],unit=i===3?'g/L':'mmol/L';g.fillStyle='#df657012';g.fillRect(20,y,415,110);g.fillStyle='#4598cf12';g.fillRect(465,y,415,110);g.fillStyle='#a98e6255';g.fillRect(435,y,30,110);g.textAlign='left';g.font='bold 14px system-ui';g.fillStyle=sp.c;g.fillText(sp.name,32,y+23);g.textAlign='right';g.font='12px system-ui';g.fillStyle=fg;g.fillText(i?'Cp = '+cp.toFixed(2)+' '+unit:'Presión capilar = '+r.pc.toFixed(1)+' mmHg',415,y+23);g.textAlign='left';g.fillText(i?'Cd = '+cd.toFixed(3)+' '+unit:'Presión abdominal = '+r.pa.toFixed(1)+' mmHg',485,y+23);\n",
        "if(Math.abs(flux)>1e-10){canvasArrow(g,dir>0?350:550,dir>0?550:350,y+62,sp.c);const speed=15+55*Math.min(1,Math.abs(flux)/sp.scale);for(let n=0;n<12;n++){let x=50+((n*67+dir*seconds*speed)%800+800)%800;g.fillStyle=sp.c;g.beginPath();if(i===3){g.ellipse(x,y+62+(n%3-1)*9,7,4,0,0,Math.PI*2)}else g.arc(x,y+62+(n%3-1)*9,i===0?3:4,0,Math.PI*2);g.fill()}}\n",
