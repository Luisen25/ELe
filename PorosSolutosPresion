        "$('cycleplay').onclick=()=>{cycleRunning=!cycleRunning;cycleClock=+$('cycletime').value;if(cycleClock>=+$('cycletime').max){cycleClock=0;$('cycletime').value=0} $('cycleplay').textContent=cycleRunning?'Pausar ciclo':'Reproducir ciclo'};\n",
