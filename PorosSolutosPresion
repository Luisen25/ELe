              " gx.strokeStyle='#d97706';gx.lineWidth=2.5;gx.beginPath();ys.forEach((y,i)=>{i?gx.lineTo(X(i*4),Y(y)):gx.moveTo(X(0),Y(y))});gx.stroke();\n",
              " gx.fillStyle='#d97706';gx.beginPath();gx.arc(X(p.tm),Y(calc(p,p.tm).UF),5,0,6.283);gx.fill()}\n",
              "let run=false,lastFrame=null,clock=0;\n",
              "$('pl').onclick=e=>{run=!run;clock=+$('tm').value;e.target.textContent=run?'Pausa':'Reproducir';if(run&&+$('tm').value>=360){$('tm').value=0;clock=0}};\n",
              "function loop(now){if(lastFrame===null)lastFrame=now;const dt=Math.min(.1,(now-lastFrame)/1000);lastFrame=now;if(run){clock+=dt*12;const t=clock;if(t>=360){$('tm').value=360;run=false;$('pl').textContent='Reproducir'}else $('tm').value=t}draw();requestAnimationFrame(loop)}\n",
