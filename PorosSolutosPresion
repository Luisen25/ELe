              "<meta charset=\"utf-8\">\n",
              "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n",
              "<title>Diálisis peritoneal: poros, solutos y ciclo completo</title>\n",
              "<style>\n",
              ":root{--bg:#fff;--fg:#1d1d1f;--mut:#666;--card:#f3f4f6;--bl:rgba(255,120,120,.16);--pe:rgba(80,160,255,.16);--mem:rgba(190,150,100,.45);\n",
              "box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}\n",
              "@media (prefers-color-scheme:dark){:root:not([data-theme=\"light\"]){--bg:#17181b;--fg:#ececec;--mut:#a0a0a0;--card:#24262b;--bl:rgba(255,100,100,.2);--pe:rgba(80,150,255,.2);--mem:rgba(200,160,110,.4);color-scheme:dark}}\n",
