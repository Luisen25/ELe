              "// Fluid silhouette.\n",
              "g.fillStyle='#efc5ae';g.strokeStyle='#aa7e6e';g.lineWidth=2;g.beginPath();g.arc(145,90,25,0,Math.PI*2);g.fill();g.stroke();g.beginPath();g.moveTo(118,122);g.lineTo(95,146);g.lineTo(76,257);g.lineTo(94,262);g.lineTo(111,195);g.lineTo(113,289);g.lineTo(105,379);g.lineTo(129,379);g.lineTo(145,293);g.lineTo(159,379);g.lineTo(183,379);g.lineTo(176,289);g.lineTo(179,195);g.lineTo(196,262);g.lineTo(214,257);g.lineTo(195,146);g.lineTo(171,122);g.closePath();g.fill();g.stroke();\n",
              "const fluid=Math.max(0,Math.min(1,v.excess/5000));g.fillStyle='#5daae5';g.globalAlpha=.25+fluid*.6;g.beginPath();g.ellipse(145,225,24+12*fluid,35+30*fluid,0,0,Math.PI*2);g.fill();g.globalAlpha=1;g.fillStyle=fg;g.font='13px system-ui';g.fillText('Δ líquido corporal del modelo',145,410);g.font='bold 18px system-ui';g.fillText((v.excess/1000).toFixed(2)+' L',145,437);g.font='11px system-ui';g.fillText('Sangre + intersticio; excluye dializado',145,457);\n",
              "// Vessel: radius is only a visual encoding of systemic resistance.\n",
              "const half=36*Math.pow(18/v.a.rs,.25);g.fillStyle='#d87c7c';g.fillRect(348,181,200,2*half+14);g.fillStyle='#aa3d51';g.fillRect(348,188,200,2*half);for(let i=0;i<7;i++){g.fillStyle='#efb2a7';g.beginPath();g.ellipse(355+(seconds*45+i*28)%185,188+half+Math.sin(i)*half*.5,8,4,0,0,Math.PI*2);g.fill()}\n",
              "g.fillStyle=fg;g.font='13px system-ui';g.fillText('Rs = '+v.a.rs.toFixed(1)+' mmHg·min/L',448,160);g.font='bold 18px system-ui';g.fillText('PAM '+v.r.map.toFixed(0)+' mmHg',448,330);g.font='12px system-ui';g.fillText('PAD '+v.r.rap.toFixed(1)+' mmHg · precarga derecha',448,355);g.fillText('Q '+v.r.q.toFixed(2)+' L/min',448,378);\n",
              "canvasArrow(g,245,320,225,'#547ea4');canvasArrow(g,570,625,225,'#c37461');heartDraw(g,739,220,.92,v,seconds);g.fillStyle=fg;g.font='bold 17px system-ui';g.fillText('PAS '+v.pas.toFixed(0)+' mmHg',745,385);g.font='13px system-ui';g.fillText('Esfuerzo medio '+v.stress.toFixed(1)+' kPa',745,411);g.fillText('FC '+v.r.hr.toFixed(1)+' lat/min · pared '+v.wall.toFixed(1)+' cm',745,434);g.font='11px system-ui';g.fillText(v.structure==='fibrosis'?'Marcas doradas: fibrosis ilustrativa':'Corte esquemático del corazón',745,456);\n",
              "// Chronic pathway is explicitly separate from the time-dependent simulation.\n",
              "g.strokeStyle='#9998';g.setLineDash([5,5]);g.beginPath();g.moveTo(25,486);g.lineTo(875,486);g.stroke();g.setLineDash([]);g.fillStyle=fg;g.font='bold 13px system-ui';g.fillText('POSIBLES CAMBIOS CRÓNICOS · NO CALCULADOS DURANTE ESTE CICLO',450,512);g.font='13px system-ui';g.fillText('Sobrecarga sostenida',135,551);g.fillText('Hipertrofia / remodelado',450,551);g.fillText('Fibrosis / mayor rigidez',760,551);canvasArrow(g,240,315,546,'#aa8b64');canvasArrow(g,575,640,546,'#aa8b64');g.fillStyle=fg;g.font='11px system-ui';g.fillText('La respuesta no es inevitable ni una secuencia obligatoria. Reducir la presión no equivale a borrar fibrosis.',450,581);\n",
              "const item=(value,title)=>'<div class=\"metric\"><strong>'+value+'</strong><span>'+title+'</span></div>';$('heartmetrics').innerHTML=item(v.ptm.toFixed(1)+' mmHg','Presión transmural aproximada')+item(v.stress.toFixed(2)+' kPa','Esfuerzo de cáscara esférica')+item(v.ratio.toFixed(2)+' ×','Respecto a la referencia mecánica')+item((v.r.ufcum/1000).toFixed(2)+' L','UF neta acumulada del ciclo');}\n",
              "function resetHeartCycle(){cycleRunning=false;cycleClock=0;$('cycletime').value=0;$('cycleplay').textContent='Reproducir ciclo';cvRender()}\n",
              "$('heartvolume').onclick=()=>{$('excess').value=3000;$('heartmanual').checked=false;resetHeartCycle()};\n",
              "$('heartresistance').onclick=()=>{$('rs').value=26;$('heartmanual').checked=false;resetHeartCycle()};\n",
              "$('heartreference').onclick=()=>{$('excess').value=0;$('rs').value=18;$('gain').value=1;$('heartmanual').checked=false;resetHeartCycle()};\n",
              "$('heartstructure').onchange=()=>{if($('heartstructure').value!=='reference')$('heartwall').value=1.6;else $('heartwall').value=1};\n",
              "\n",
              "\n",
              "\n",
              "function renderSync(){if(!soluteState)return;const {r}=soluteState;const item=(v,t)=>'<div class=\"metric\"><strong>'+v+'</strong><span>'+t+'</span></div>';$('syncmetrics').innerHTML=item(r.hr.toFixed(1)+' lat/min','FC estimada')+item(r.map.toFixed(1)+' mmHg','PAM del mismo instante')+item(r.q.toFixed(2)+' L/min','Gasto cardíaco')+item(r.sv.toFixed(1)+' mL','Volumen sistólico equivalente')+item(r.vd.toFixed(0)+' mL','Líquido en cavidad');cvChart('hrchart',cvData.rows,[{n:'FC estimada',c:'#c84967',f:x=>x.hr}],'Frecuencia · lat/min',r.t)}\n",
              "function jumpPhase(phase){if(!cvData||!cvData.rows.length)return;const rows=cvData.rows.filter(r=>r.phase===phase);if(!rows.length)return;cycleRunning=false;$('cycleplay').textContent='Reproducir ciclo';const t=rows[Math.floor(rows.length/2)].t;cycleClock=t;$('cycletime').value=t;cvRender();drawSolutes(visualTime);drawCardiac(heartSeconds)}\n",
              "$('jumpfill').onclick=()=>jumpPhase(0);$('jumpdwell').onclick=()=>jumpPhase(1);$('jumpdrain').onclick=()=>jumpPhase(2);\n",
              "\n",
              "$('cvreset').onclick=()=>{cvIds.forEach((id,i)=>$(id).value=cvDefaults[i]);cvRender()};\n",
              "$('cvexport').onclick=()=>{cvRender();if($('cvexport').disabled)return;const head=['t_min','Vd_mL','Vb_mL','Vi_mL','Pab_mmHg','PAD_mmHg','PAM_mmHg','Pcap_mmHg','Q_Lmin','UF_mLmin','E_PAD_mmHg_min','E_PAM_mmHg_min','phase_0fill_1dwell_2drain','glucoseD_mmolL','ureaD_mmolL','albuminD_gL','glucoseFlux_mmolmin','ureaFlux_mmolmin','albuminFlux_gmin','fill_mL','drain_mL','UFcum_mL','glucoseDrained_mmol','ureaDrained_mmol','albuminDrained_g','HR_beats_min','SV_equivalent_mL'];const lines=['# Modelo exploratorio; exposicion no equivale a dano cardiaco','# Parametros Starling: '+JSON.stringify(cvP),'# Parametros cardiovasculares: '+JSON.stringify(cvA),'# RK4 dt=0.25 min; constantes y dominio documentados en HTML','# Detenida_fuera_de_dominio='+cvData.stopped,head.join(',')];for(const r of cvData.rows)lines.push([r.t,r.vd,r.vb,r.vi,r.pa,r.rap,r.map,r.pc,r.q,r.uf,r.erap,r.emap,r.phase,r.gd,r.ud,r.ad,r.gflux,r.uflux,r.aflux,r.vin,r.vout,r.ufcum,r.gout,r.uout,r.aout,r.hr,r.sv].map(v=>v.toFixed(6)).join(','));const u=URL.createObjectURL(new Blob(['\\uFEFF'+lines.join('\\n')],{type:'text/csv;charset=utf-8'})),link=document.createElement('a');link.href=u;link.download='starling_cardiovascular.csv';link.click();setTimeout(()=>URL.revokeObjectURL(u),1000)};\n",
              "document.querySelectorAll('input').forEach(el=>el.addEventListener('input',cvRender));\n",
              "let cvLastTime=-1;setInterval(()=>{if(cvLastTime!==+$('cycletime').value){cvLastTime=+$('cycletime').value;cvRender()}},150);\n",
              "cvRender();\n",
              "</script>\n",
