              " [r.Fh&&0,0].length;\n",
              " ['pv','pi','po','cg','sg','sp','Lp','S','tm'].forEach((id,i)=>$('v'+(i+1)).textContent=id==='sp'?p.sp.toFixed(2):(+$(id).value));\n",
              " $('sp').disabled=$('one').checked;\n",
              " $('res').innerHTML=`Glucosa del dializado: <b>${r.c.toFixed(0)} mmol/L</b> (π<sub>I</sub> = ${r.piI.toFixed(0)} mmHg) · ΔP = P<sub>I</sub> − P<sub>v</sub> = <b>${(p.pI-p.pv).toFixed(1)} mmHg</b> · L<sub>p</sub>S = <b>${(p.Lp*p.S).toFixed(3)} mL/min/mmHg</b><br>J<sub>v</sub> = <b>${r.J.toFixed(2)} mL/min</b> · con linfática (${Jl} mL/min): <b>${r.UF.toFixed(2)} mL/min</b> · UF acumulada: <b>${cum(p,p.tm).toFixed(0)} mL</b>`;\n",
              " plot(p)}\n",
              "function cum(p,t){return p.Lp*p.S*((p.pv-p.pI-p.sp*p.po)*t+p.sg*RT*(p.cg-Cp)*TAU*(1-Math.exp(-t/TAU)))-Jl*t}\n",
              "function plot(p){\n",
